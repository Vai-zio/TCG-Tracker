<?xml version="1.0" encoding="utf-8"?>
<!--
  A self-contained build for 64-bit Windows: the .NET runtime is included, so the PC needs nothing installed.
  Use: dotnet publish src/PokemonCardManager.App -p:PublishProfile=win-x64
  Output: artifacts/publish/win-x64 (copy the whole folder; run PokemonCardManager.App.exe).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- A folder, not a single .exe: OpenCV's native library and WPF load more reliably this way. -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- No trimming: WPF and EF Core use reflection, and trimming can break them. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
