{
  "Storage": {
    "DataDirectory": "",
    "DatabaseFileName": "collection.db",
    "MaxImageSizeMegabytes": 100
  },
  "Collection": {
    "DefaultCurrency": "DKK"
  },
  "Catalogs": {
    "TcgdexEnabled": true,
    "TimeoutSeconds": 10
  },
  "ImageQuality": {
    "MinShortSide": 1000,
    "MinSharpness": 40,
    "GoodSharpness": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
