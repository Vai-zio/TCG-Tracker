<Application x:Class="PokemonCardManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PokemonCardManager.App.ViewModels"
             xmlns:views="clr-namespace:PokemonCardManager.App.Views"
             xmlns:conv="clr-namespace:PokemonCardManager.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <!-- No StartupUri: App.xaml.cs creates the window through dependency injection. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumToTextConverter x:Key="EnumToText" />
            <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!--
                How navigation finds a view: when the shell shows a ViewModel,
                WPF looks up the DataTemplate for its type and creates that view.
            -->
            <DataTemplate DataType="{x:Type vm:CollectionViewModel}">
                <views:CollectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CardEditorViewModel}">
                <views:CardEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StorageLocationsViewModel}">
                <views:StorageLocationsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
