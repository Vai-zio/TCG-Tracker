<Window x:Class="PokemonCardManager.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pokémon Card Manager" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <DockPanel Background="{StaticResource NavBackgroundBrush}">
            <TextBlock DockPanel.Dock="Top" Text="Card Manager" Foreground="White" FontSize="16" FontWeight="SemiBold"
                       Margin="16,18,16,18" />
            <ItemsControl ItemsSource="{Binding Items}" KeyboardNavigation.TabNavigation="Cycle">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding Command}"
                                AutomationProperties.Name="{Binding Title}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Current page: a ViewModel, displayed through the DataTemplates in App.xaml -->
        <ContentControl Grid.Column="1" Content="{Binding Navigation.CurrentPage}" Focusable="False" Margin="24,20,24,20" />
    </Grid>
</Window>
