<Window x:Class="PokemonCardManager.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pokémon Card Manager" Width="1360" Height="860" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <!-- One sidebar entry: icon + title. Disabled entries show when they're coming. -->
        <DataTemplate x:Key="NavItemTemplate">
            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding Command}"
                    AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Note}" ToolTipService.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconTextStyle}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Soft pastel glows behind everything; the translucent panels let them show through like frosted glass -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="560" Height="560" Canvas.Left="-140" Canvas.Top="-180" Fill="{DynamicResource Glow1Brush}">
                <Ellipse.Effect><BlurEffect Radius="160" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="520" Height="520" Canvas.Left="760" Canvas.Top="380" Fill="{DynamicResource Glow2Brush}">
                <Ellipse.Effect><BlurEffect Radius="170" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="420" Height="420" Canvas.Left="1100" Canvas.Top="-120" Fill="{DynamicResource Glow3Brush}">
                <Ellipse.Effect><BlurEffect Radius="150" /></Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Logo: a pastel Poké Ball made of shapes -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,16,26">
                        <Grid Width="34" Height="34" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource PinkBrush}" />
                            <Path Data="M0,17 A17,17 0 0 0 34,17 Z" Fill="{DynamicResource SurfaceSolidBrush}" />
                            <Rectangle Height="3" Fill="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" />
                            <Ellipse Width="12" Height="12" Fill="{DynamicResource SurfaceSolidBrush}" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="3" />
                        </Grid>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Pokémon" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Card Manager" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                        <ContentControl Content="{Binding SettingsItem}" ContentTemplate="{StaticResource NavItemTemplate}" Focusable="False" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding MainItems}" ItemTemplate="{StaticResource NavItemTemplate}" Focusable="False" />
                            <TextBlock Text="COMING NEXT" Style="{StaticResource SubtleTextStyle}" Margin="26,18,0,6" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding UpcomingItems}" ItemTemplate="{StaticResource NavItemTemplate}" Focusable="False" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Top bar + current page -->
            <DockPanel Grid.Column="1">
                <DockPanel DockPanel.Dock="Top" Margin="28,18,28,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="{Binding ThemeGlyph}"
                            Command="{Binding ToggleThemeCommand}" ToolTip="Switch between dark and light theme"
                            AutomationProperties.Name="Switch theme" Margin="12,0,0,0" />
                    <!-- Global search: opens the collection with the results -->
                    <Grid MaxWidth="520" HorizontalAlignment="Left">
                        <TextBox x:Name="GlobalSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="36,6,12,6"
                                 AutomationProperties.Name="Search cards, sets or collector numbers"
                                 ToolTip="Search cards, sets or collector numbers (Ctrl+K)">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconTextStyle}" FontSize="13" HorizontalAlignment="Left"
                                   Margin="13,0,0,0" Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False" />
                        <TextBlock Text="Search cards, sets or collector numbers…" Margin="37,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=GlobalSearch, Converter={StaticResource EmptyToVisibility}}" />
                    </Grid>
                </DockPanel>

                <!-- The current page is a ViewModel; App.xaml's DataTemplates pick its view -->
                <ContentControl Content="{Binding Navigation.CurrentPage}" Focusable="False" Margin="28,16,28,24" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
