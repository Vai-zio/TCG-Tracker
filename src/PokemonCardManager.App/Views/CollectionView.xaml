<UserControl x:Class="PokemonCardManager.App.Views.CollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCardCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Title and main actions -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Edit" Command="{Binding EditCardCommand}" Margin="0,0,8,0" />
                <Button Content="Inspect" Command="{Binding InspectCardCommand}" Margin="0,0,8,0" />
                <Button Content="Delete" Command="{Binding DeleteCardCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Add from photos" Command="{Binding AddFromPhotosCommand}" Margin="0,0,8,0" />
                <Button Content="_New card (Ctrl+N)" Command="{Binding NewCardCommand}" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
            <TextBlock Text="Collection" Style="{StaticResource PageTitleStyle}" />
        </DockPanel>

        <!-- Search and filters -->
        <Border DockPanel.Dock="Top" Style="{StaticResource GlassPanelStyle}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Clear filters" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Search" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search by card name, Pokémon or collector number"
                             ToolTip="Search by card name, Pokémon or collector number (Enter)">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RefreshCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Width" Value="170" />
                            <Setter Property="Margin" Value="0,0,8,4" />
                            <Setter Property="DisplayMemberPath" Value="Label" />
                        </Style>
                    </WrapPanel.Resources>
                    <ComboBox ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}" AutomationProperties.Name="Set" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="120" AutomationProperties.Name="Language" />
                    <ComboBox ItemsSource="{Binding Rarities}" SelectedItem="{Binding SelectedRarity}" Width="140" AutomationProperties.Name="Rarity" />
                    <ComboBox ItemsSource="{Binding Finishes}" SelectedItem="{Binding SelectedFinish}" Width="140" AutomationProperties.Name="Finish" />
                    <ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding SelectedCondition}" Width="150" AutomationProperties.Name="Condition" />
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" AutomationProperties.Name="Status" />
                    <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" Width="200" AutomationProperties.Name="Storage location" />
                    <!-- Value range on your own estimate. Applied with Enter or Search, like the search box. -->
                    <TextBlock Text="Value" VerticalAlignment="Center" Margin="8,0,6,4" Style="{StaticResource MutedTextStyle}" />
                    <TextBox Text="{Binding MinValueText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,4,4"
                             AutomationProperties.Name="Value from" ToolTip="Lowest estimated value (Enter)">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RefreshCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,4,4" />
                    <TextBox Text="{Binding MaxValueText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,4,4"
                             AutomationProperties.Name="Value to" ToolTip="Highest estimated value (Enter)">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RefreshCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBox Text="{Binding ValueCurrency, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,8,4" MaxLength="3"
                             AutomationProperties.Name="Value currency"
                             ToolTip="Only cards estimated in this currency match: amounts in different currencies can't be compared">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RefreshCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Sort by" VerticalAlignment="Center" Margin="8,0,6,4" Style="{StaticResource MutedTextStyle}" />
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Width="150" AutomationProperties.Name="Sort by" />
                    <CheckBox Content="Descending" IsChecked="{Binding Descending}" Margin="0,0,16,4" VerticalAlignment="Center" />
                    <!-- Grid / Table switch: two radio buttons styled as one pill -->
                    <Border Style="{StaticResource SegmentTrackStyle}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentStyle}" GroupName="View" IsChecked="{Binding ShowGrid}" ToolTip="Grid view">
                                <TextBlock Text="&#xF0E2;" Style="{StaticResource IconTextStyle}" FontSize="13" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentStyle}" GroupName="View" IsChecked="{Binding ShowTable}" ToolTip="Table view">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource IconTextStyle}" FontSize="13" />
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <!-- Saved filters: pick one to apply it; type a name and Save to keep the current filters -->
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="Saved filters" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextStyle}" />
                    <ComboBox ItemsSource="{Binding SavedFilters}" SelectedItem="{Binding SelectedSavedFilter}" DisplayMemberPath="Name"
                              Width="200" Margin="0,0,8,0" AutomationProperties.Name="Saved filters" />
                    <Button Content="Delete" Command="{Binding DeleteFilterCommand}" Margin="0,0,16,0" />
                    <TextBox Text="{Binding NewFilterName, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,8,0"
                             AutomationProperties.Name="Name for saved filter" ToolTip="Name for the current filters. An existing name is replaced." />
                    <Button Content="Save filters" Command="{Binding SaveFilterCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding FilterMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding FilterMessage, Converter={StaticResource NotEmptyToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Bulk edit: shown when two or more cards are selected (Ctrl+click or Shift+click) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource GlassPanelStyle}" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding HasMultipleSelected, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel>
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold">
                    <Run Text="{Binding SelectedCount, Mode=OneWay}" /> <Run Text="cards selected" />
                </TextBlock>
                <ComboBox ItemsSource="{Binding BulkLocations}" SelectedItem="{Binding BulkLocation}" DisplayMemberPath="Label"
                          Width="220" Margin="0,0,8,0" AutomationProperties.Name="Bulk location" />
                <ComboBox ItemsSource="{Binding BulkStatuses}" SelectedItem="{Binding BulkStatus}" DisplayMemberPath="Label"
                          Width="190" Margin="0,0,8,0" AutomationProperties.Name="Bulk status" />
                <ComboBox ItemsSource="{Binding BulkConditions}" SelectedItem="{Binding BulkCondition}" DisplayMemberPath="Label"
                          Width="200" Margin="0,0,8,0" AutomationProperties.Name="Bulk condition" />
                <Button Content="Apply to selected" Command="{Binding ApplyBulkCommand}" Style="{StaticResource AccentButtonStyle}" />
            </WrapPanel>
        </Border>

        <!-- Paging -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="‹ Previous" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="Page" /> <Run Text="{Binding Page, Mode=OneWay}" /> <Run Text="of" /> <Run Text="{Binding PageCount, Mode=OneWay}" />
                </TextBlock>
                <Button Content="Next ›" Command="{Binding NextPageCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
        </DockPanel>

        <!-- Results. Only visible rows are created (virtualization); thumbnails load in the background. -->
        <Grid>
            <!-- Thumbnail grid view (one page at a time, so at most 200 tiles) -->
            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectionMode="Extended"
                     SelectionChanged="OnSelectionChanged"
                     Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibility}}"
                     MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent"
                     BorderThickness="0" AutomationProperties.Name="Cards">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- A glass tile per card: picture, name, set and a pastel condition chip -->
                        <Border Width="168" Margin="6" Padding="10" Style="{StaticResource GlassTileStyle}">
                            <StackPanel>
                                <Border Height="210" Background="{DynamicResource InputBrush}" CornerRadius="10" ClipToBounds="True">
                                    <Image Source="{Binding LargeThumbnail, IsAsync=True}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding CardName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding SetName, Mode=OneWay}" /> <Run Text="#" /><Run Text="{Binding CollectorNumber, Mode=OneWay}" />
                                </TextBlock>
                                <Border Style="{StaticResource ChipStyle}" Background="{DynamicResource LavenderSoftBrush}" HorizontalAlignment="Left" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Condition}" FontSize="11" Foreground="{DynamicResource LavenderBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                      RowHeight="56" MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKeyDown"
                      Visibility="{Binding ShowTable, Converter={StaticResource BoolToVisibility}}"
                      AutomationProperties.Name="Cards">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Thumbnail, IsAsync=True}" Height="48" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding CardName}" Width="2*" />
                    <DataGridTextColumn Header="Set" Binding="{Binding SetName}" Width="2*" />
                    <DataGridTextColumn Header="No." Binding="{Binding CollectorNumber}" Width="60" />
                    <DataGridTextColumn Header="Lang" Binding="{Binding Language}" Width="50" />
                    <DataGridTextColumn Header="Finish" Binding="{Binding Finish}" Width="*" />
                    <DataGridTextColumn Header="Rarity" Binding="{Binding Rarity}" Width="*" />
                    <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="1.5*" />
                    <DataGridTextColumn Header="Paid" Binding="{Binding Price}" Width="*" />
                    <DataGridTextColumn Header="Est. value" Binding="{Binding Value}" Width="*" />
                    <DataGridTextColumn Header="Acquired" Binding="{Binding AcquiredOn, StringFormat=d}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
