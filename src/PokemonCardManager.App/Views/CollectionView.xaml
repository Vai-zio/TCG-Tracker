<UserControl x:Class="PokemonCardManager.App.Views.CollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCardCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Title and main actions -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Edit" Command="{Binding EditCardCommand}" Margin="0,0,8,0" />
                <Button Content="Delete" Command="{Binding DeleteCardCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" />
                <Button Content="_New card (Ctrl+N)" Command="{Binding NewCardCommand}" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
            <TextBlock Text="Collection" Style="{StaticResource PageTitleStyle}" />
        </DockPanel>

        <!-- Search and filters -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardPanelStyle}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Clear filters" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Search" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search by card name, Pokémon or collector number"
                             ToolTip="Search by card name, Pokémon or collector number (Enter)">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RefreshCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Width" Value="170" />
                            <Setter Property="Margin" Value="0,0,8,4" />
                            <Setter Property="DisplayMemberPath" Value="Label" />
                        </Style>
                    </WrapPanel.Resources>
                    <ComboBox ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}" AutomationProperties.Name="Set" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="120" AutomationProperties.Name="Language" />
                    <ComboBox ItemsSource="{Binding Rarities}" SelectedItem="{Binding SelectedRarity}" Width="140" AutomationProperties.Name="Rarity" />
                    <ComboBox ItemsSource="{Binding Finishes}" SelectedItem="{Binding SelectedFinish}" Width="140" AutomationProperties.Name="Finish" />
                    <ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding SelectedCondition}" Width="150" AutomationProperties.Name="Condition" />
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" AutomationProperties.Name="Status" />
                    <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" Width="200" AutomationProperties.Name="Storage location" />
                    <TextBlock Text="Sort by" VerticalAlignment="Center" Margin="8,0,6,4" Style="{StaticResource MutedTextStyle}" />
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Width="150" AutomationProperties.Name="Sort by" />
                    <CheckBox Content="Descending" IsChecked="{Binding Descending}" Margin="0,0,16,4" />
                    <CheckBox Content="_Grid view" IsChecked="{Binding ShowGrid}" Margin="0,0,0,4" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Paging -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="‹ Previous" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="Page" /> <Run Text="{Binding Page, Mode=OneWay}" /> <Run Text="of" /> <Run Text="{Binding PageCount, Mode=OneWay}" />
                </TextBlock>
                <Button Content="Next ›" Command="{Binding NextPageCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
        </DockPanel>

        <!-- Results. Only visible rows are created (virtualization); thumbnails load in the background. -->
        <Grid>
            <!-- Thumbnail grid view (one page at a time, so at most 200 tiles) -->
            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                     Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibility}}"
                     MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{StaticResource SurfaceBrush}"
                     BorderBrush="{StaticResource BorderBrush}" AutomationProperties.Name="Cards">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="150" Margin="6">
                            <Border Height="210" Background="{StaticResource WindowBackgroundBrush}" CornerRadius="4">
                                <Image Source="{Binding LargeThumbnail, IsAsync=True}" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="{Binding CardName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding SetName, Mode=OneWay}" /> <Run Text="#" /><Run Text="{Binding CollectorNumber, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      RowHeight="56" MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKeyDown"
                      Visibility="{Binding ShowTable, Converter={StaticResource BoolToVisibility}}"
                      AutomationProperties.Name="Cards">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Thumbnail, IsAsync=True}" Height="48" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding CardName}" Width="2*" />
                    <DataGridTextColumn Header="Set" Binding="{Binding SetName}" Width="2*" />
                    <DataGridTextColumn Header="No." Binding="{Binding CollectorNumber}" Width="60" />
                    <DataGridTextColumn Header="Lang" Binding="{Binding Language}" Width="50" />
                    <DataGridTextColumn Header="Finish" Binding="{Binding Finish}" Width="*" />
                    <DataGridTextColumn Header="Rarity" Binding="{Binding Rarity}" Width="*" />
                    <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="1.5*" />
                    <DataGridTextColumn Header="Paid" Binding="{Binding Price}" Width="*" />
                    <DataGridTextColumn Header="Acquired" Binding="{Binding AcquiredOn, StringFormat=d}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
