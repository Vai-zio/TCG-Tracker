<UserControl x:Class="PokemonCardManager.App.Views.IdentifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PokemonCardManager.App.ViewModels">
    <UserControl.InputBindings>
        <KeyBinding Key="Return" Modifiers="Control" Command="{Binding AddCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Title and actions -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="80" Margin="0,0,8,0"
                          ToolTip="Language printed on the cards" AutomationProperties.Name="Card language" />
                <Button Content="Stop" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="_Choose photos…" Command="{Binding ChoosePhotosCommand}" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Add from photos" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,2" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14" TextWrapping="Wrap">
                    <Run Text="Photograph the card front, flat on a plain background. Searching:" />
                    <Run Text="{Binding CatalogNames, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Progress}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"
                   Visibility="{Binding Progress, Converter={StaticResource NotEmptyToVisibility}}" />

        <!-- Empty state -->
        <Border Style="{StaticResource GlassPanelStyle}" VerticalAlignment="Top"
                Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="How it works" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"
                           Text="1. Choose one or many photos. 2. Each photo is checked, the card is found and straightened, and its name and number are read. 3. Matches from your collection and TCGdex are ranked. 4. Pick the right one (or correct the details) and add it. Your original photo is kept unchanged." />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Batch -->
            <Border Style="{StaticResource GlassPanelStyle}" Padding="8">
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="Photos to identify">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2">
                                <Border DockPanel.Dock="Left" Width="40" Height="54" CornerRadius="6" Background="{DynamicResource InputBrush}"
                                        ClipToBounds="True" Margin="0,0,8,0">
                                    <Image Source="{Binding Thumbnail, IsAsync=True}" Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- What the app saw -->
            <Border Grid.Column="2" Style="{StaticResource GlassPanelStyle}" DataContext="{Binding Selected}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Straightened card" Style="{StaticResource SectionTitleStyle}" />
                        <Border CornerRadius="10" Background="{DynamicResource InputBrush}" Height="360" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding Preview}" Stretch="Uniform" />
                                <TextBlock Text="Reading…" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}"
                                           Visibility="{Binding Preview, Converter={StaticResource EmptyToVisibility}}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Background="{DynamicResource PeachSoftBrush}" Padding="10,6" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Matches and the card form -->
            <Border Grid.Column="4" Style="{StaticResource GlassPanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Selected}">
                        <TextBlock Text="Read from the photo" Style="{StaticResource SectionTitleStyle}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ReadName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name read"
                                     ToolTip="Card name; correct it if it was misread" />
                            <TextBox Grid.Column="2" Text="{Binding ReadNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Number read"
                                     ToolTip="Collector number, e.g. 136/189" />
                            <Button Grid.Column="4" Content="Search again"
                                    Command="{Binding DataContext.SearchAgainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Grid>

                        <TextBlock Text="Matches" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding HasNoCandidates, Converter={StaticResource BoolToVisibility}}"
                                   Text="No matches. Correct the name or number above and search again, or fill in the card below by hand." />
                        <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" Background="Transparent"
                                 BorderThickness="0" Margin="0,0,0,12" AutomationProperties.Name="Matches">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                        <TextBlock Text="{Binding Reasons}" Style="{StaticResource SubtleTextStyle}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Card to add" Style="{StaticResource SectionTitleStyle}" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,8">
                                <Label Content="Set *" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding SetName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Set" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <Label Content="Card name *" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding CardName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Card name" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <Label Content="Number *" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding CollectorNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Collector number" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <Label Content="Rarity" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Rarity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rarity" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <Label Content="Finish" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Source={x:Static vm:IdentifyItemViewModel.Finishes}}" SelectedItem="{Binding Finish}"
                                          AutomationProperties.Name="Finish" ToolTip="Photos can't reliably tell normal, holo and reverse holo apart; check the card" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <Label Content="Edition" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Edition, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Edition"
                                         ToolTip="e.g. 1st Edition, Shadowless; empty for the normal printing" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <Label Content="Language" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Language" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <Label Content="Status" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Source={x:Static vm:IdentifyItemViewModel.Statuses}}" SelectedItem="{Binding Status}"
                                          AutomationProperties.Name="Status" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisibility}}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="_Add to collection (Ctrl+Enter)" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                                    Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Content="Skip" Margin="0,0,8,0"
                                    Command="{Binding DataContext.SkipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Content="Open added card"
                                    Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
