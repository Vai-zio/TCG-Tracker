<UserControl x:Class="PokemonCardManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A stat tile: pastel icon bubble, label, big number, small note -->
        <Style x:Key="TileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
        <Style x:Key="IconBubbleStyle" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />

            <!-- Getting started, only when the collection is empty -->
            <Border Style="{StaticResource GlassTileStyle}" Margin="0,0,0,16"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Add your first card" Command="{Binding AddCardCommand}"
                            Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Welcome! Your collection is empty." Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Add a card to see your numbers here. Everything on this page is counted from your own data."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Stat tiles -->
            <UniformGrid Columns="4" Margin="-8,0,-8,8">
                <Border Style="{StaticResource GlassTileStyle}" Margin="8">
                    <StackPanel>
                        <Border Style="{StaticResource IconBubbleStyle}" Background="{DynamicResource LavenderSoftBrush}">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource IconTextStyle}" Foreground="{DynamicResource LavenderBrush}" />
                        </Border>
                        <TextBlock Text="Physical cards" Style="{StaticResource TileLabelStyle}" />
                        <TextBlock Text="{Binding Summary.PhysicalCards, StringFormat=N0}" Style="{StaticResource TileValueStyle}" />
                        <TextBlock Foreground="{DynamicResource MintBrush}" FontSize="12">
                            <Run Text="+" /><Run Text="{Binding Summary.AddedThisMonth, Mode=OneWay}" /><Run Text=" this month" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassTileStyle}" Margin="8">
                    <StackPanel>
                        <Border Style="{StaticResource IconBubbleStyle}" Background="{DynamicResource SkySoftBrush}">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource IconTextStyle}" Foreground="{DynamicResource SkyBrush}" />
                        </Border>
                        <TextBlock Text="Distinct printings" Style="{StaticResource TileLabelStyle}" />
                        <TextBlock Text="{Binding Summary.DistinctPrintings, StringFormat=N0}" Style="{StaticResource TileValueStyle}" />
                        <TextBlock Text="set + number + language + finish" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassTileStyle}" Margin="8">
                    <StackPanel>
                        <Border Style="{StaticResource IconBubbleStyle}" Background="{DynamicResource PeachSoftBrush}">
                            <TextBlock Text="&#xE734;" Style="{StaticResource IconTextStyle}" Foreground="{DynamicResource PeachBrush}" />
                        </Border>
                        <TextBlock Text="Grading candidates" Style="{StaticResource TileLabelStyle}" />
                        <TextBlock Text="{Binding Summary.GradingCandidates, StringFormat=N0}" Style="{StaticResource TileValueStyle}" />
                        <TextBlock Text="cards marked as candidates" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                </Border>
                <!-- Honest placeholder: values need price data (Milestone 6) -->
                <Border Style="{StaticResource GlassTileStyle}" Margin="8">
                    <StackPanel>
                        <Border Style="{StaticResource IconBubbleStyle}" Background="{DynamicResource MintSoftBrush}">
                            <TextBlock Text="&#xE719;" Style="{StaticResource IconTextStyle}" Foreground="{DynamicResource MintBrush}" />
                        </Border>
                        <TextBlock Text="Estimated value" Style="{StaticResource TileLabelStyle}" />
                        <TextBlock Text="—" Style="{StaticResource TileValueStyle}" Foreground="{DynamicResource SubtleTextBrush}" />
                        <TextBlock Text="needs market prices (Milestone 6)" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Rarity breakdown -->
                <Border Style="{StaticResource GlassPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Collection by rarity" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="No cards yet." Style="{StaticResource MutedTextStyle}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Rarities}" AlternationCount="6" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedTextStyle}">
                                                <Run Text="{Binding Count, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding ShareText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Label}" />
                                        </DockPanel>
                                        <Grid Height="8" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding FilledWidth}" />
                                                <ColumnDefinition Width="{Binding EmptyWidth}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" CornerRadius="4" Background="{DynamicResource InputBrush}" />
                                            <Border x:Name="Bar" CornerRadius="4" Background="{DynamicResource LavenderBrush}" />
                                        </Grid>
                                    </StackPanel>
                                    <!-- Each row takes the next pastel colour -->
                                    <DataTemplate.Triggers>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SkyBrush}" />
                                        </Trigger>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="2">
                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource MintBrush}" />
                                        </Trigger>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="3">
                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource PeachBrush}" />
                                        </Trigger>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="4">
                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource PinkBrush}" />
                                        </Trigger>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="5">
                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource LemonBrush}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Things that need attention -->
                <Border Grid.Column="2" Style="{StaticResource GlassPanelStyle}">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style x:Key="HealthRow" TargetType="DockPanel">
                                <Setter Property="Margin" Value="0,6" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="Collection health" Style="{StaticResource SectionTitleStyle}" />
                        <DockPanel Style="{StaticResource HealthRow}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.AwaitingInspection}" FontWeight="SemiBold" />
                            <Border Style="{StaticResource IconBubbleStyle}" Width="30" Height="30" CornerRadius="10" Background="{DynamicResource PeachSoftBrush}">
                                <TextBlock Text="&#xE890;" Style="{StaticResource IconTextStyle}" FontSize="13" Foreground="{DynamicResource PeachBrush}" />
                            </Border>
                            <TextBlock Text="Awaiting inspection" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource HealthRow}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.MissingPhotos}" FontWeight="SemiBold" />
                            <Border Style="{StaticResource IconBubbleStyle}" Width="30" Height="30" CornerRadius="10" Background="{DynamicResource PinkSoftBrush}">
                                <TextBlock Text="&#xE722;" Style="{StaticResource IconTextStyle}" FontSize="13" Foreground="{DynamicResource PinkBrush}" />
                            </Border>
                            <TextBlock Text="Missing photos" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource HealthRow}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.SubmittedForGrading}" FontWeight="SemiBold" />
                            <Border Style="{StaticResource IconBubbleStyle}" Width="30" Height="30" CornerRadius="10" Background="{DynamicResource SkySoftBrush}">
                                <TextBlock Text="&#xE724;" Style="{StaticResource IconTextStyle}" FontSize="13" Foreground="{DynamicResource SkyBrush}" />
                            </Border>
                            <TextBlock Text="Submitted for grading" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource HealthRow}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.StorageLocations}" FontWeight="SemiBold" />
                            <Border Style="{StaticResource IconBubbleStyle}" Width="30" Height="30" CornerRadius="10" Background="{DynamicResource MintSoftBrush}">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextStyle}" FontSize="13" Foreground="{DynamicResource MintBrush}" />
                            </Border>
                            <TextBlock Text="Storage locations" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </DockPanel>

                        <TextBlock Text="Quick actions" Style="{StaticResource SectionTitleStyle}" Margin="0,18,0,10" />
                        <WrapPanel>
                            <Button Content="Add card" Command="{Binding AddCardCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8" />
                            <Button Content="Browse collection" Command="{Binding OpenCollectionCommand}" Margin="0,0,8,8" />
                            <Button Content="Locations" Command="{Binding OpenLocationsCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Recent activity (from the audit log) -->
                <Border Grid.Column="4" Style="{StaticResource GlassPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Recent activity" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Nothing yet." Style="{StaticResource MutedTextStyle}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Activity}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,5">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource SubtleTextStyle}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconTextStyle}" FontSize="13"
                                                   Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
