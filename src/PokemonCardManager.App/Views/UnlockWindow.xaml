<Window x:Class="PokemonCardManager.App.Views.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pokémon Card Manager" Width="520" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">
    <Grid>
        <!-- Same soft glows as the main window, so the lock screen feels like part of the app -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="380" Height="380" Canvas.Left="-120" Canvas.Top="-140" Fill="{DynamicResource Glow1Brush}">
                <Ellipse.Effect><BlurEffect Radius="140" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="340" Height="340" Canvas.Left="260" Canvas.Top="300" Fill="{DynamicResource Glow2Brush}">
                <Ellipse.Effect><BlurEffect Radius="150" /></Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Border Style="{StaticResource GlassPanelStyle}" Margin="40" Padding="32" VerticalAlignment="Center">
            <StackPanel>
                <!-- The pastel Poké Ball logo from the sidebar, larger -->
                <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Ellipse Fill="{DynamicResource PinkBrush}" />
                    <Path Data="M0,28 A28,28 0 0 0 56,28 Z" Fill="{DynamicResource SurfaceSolidBrush}" />
                    <Rectangle Height="4" Fill="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" />
                    <Ellipse Width="20" Height="20" Fill="{DynamicResource SurfaceSolidBrush}" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="4" />
                </Grid>

                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,8,0,22" />

                <Label Content="_Master password" Target="{Binding ElementName=Password}" Style="{StaticResource FieldLabelStyle}" />
                <PasswordBox x:Name="Password" AutomationProperties.Name="Master password" />

                <StackPanel Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                    <Label Content="_Type it again" Target="{Binding ElementName=Confirmation}" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox x:Name="Confirmation" AutomationProperties.Name="Confirm master password" />
                </StackPanel>

                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisibility}}" />

                <!-- IsDefault: pressing Enter clicks this button -->
                <Button Content="{Binding SubmitText}" Style="{StaticResource AccentButtonStyle}" IsDefault="True"
                        Click="OnSubmit" Margin="0,22,0,0" HorizontalAlignment="Stretch" />
                <TextBlock Text="Deriving your key…" Style="{StaticResource SubtleTextStyle}" HorizontalAlignment="Center" Margin="0,10,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
