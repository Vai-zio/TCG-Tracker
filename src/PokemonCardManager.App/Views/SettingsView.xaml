<UserControl x:Class="PokemonCardManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource GlassPanelStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Choose a theme. It changes right away and is remembered next time."
                               Style="{StaticResource MutedTextStyle}" Margin="0,0,0,12" />
                    <Border Style="{StaticResource SegmentTrackStyle}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Theme" IsChecked="{Binding IsDark}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE708;" Style="{StaticResource IconTextStyle}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Dark" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentStyle}" GroupName="Theme" IsChecked="{Binding IsLight}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE706;" Style="{StaticResource IconTextStyle}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Light" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Palette preview -->
                    <TextBlock Text="Accent colours" Style="{StaticResource MutedTextStyle}" Margin="0,18,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="34" />
                                <Setter Property="Height" Value="34" />
                                <Setter Property="CornerRadius" Value="17" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </StackPanel.Resources>
                        <Border Background="{DynamicResource LavenderBrush}" ToolTip="Lavender" />
                        <Border Background="{DynamicResource SkyBrush}" ToolTip="Sky" />
                        <Border Background="{DynamicResource MintBrush}" ToolTip="Mint" />
                        <Border Background="{DynamicResource PeachBrush}" ToolTip="Peach" />
                        <Border Background="{DynamicResource PinkBrush}" ToolTip="Pink" />
                        <Border Background="{DynamicResource LemonBrush}" ToolTip="Lemon" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassPanelStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Storage" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Change these in appsettings.json next to the app." Style="{StaticResource MutedTextStyle}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Data folder" Style="{StaticResource MutedTextStyle}" Margin="0,4" />
                        <TextBox Grid.Column="1" Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" Margin="0,4" />
                        <TextBlock Grid.Row="1" Text="Database" Style="{StaticResource MutedTextStyle}" Margin="0,4" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" Margin="0,4" />
                        <TextBlock Grid.Row="2" Text="Photos" Style="{StaticResource MutedTextStyle}" Margin="0,4" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ImagesDirectory, Mode=OneWay}" IsReadOnly="True" Margin="0,4" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SubtleTextStyle}">
                <Run Text="Pokémon Card Manager" /> <Run Text="{Binding Version, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
