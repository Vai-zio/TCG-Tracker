<UserControl x:Class="PokemonCardManager.App.Views.GradingReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PokemonCardManager.App.Controls">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!--
            One colour code for the whole page, the same as the boxes on the photo:
            green = fine (0–1), yellow = minor (2), orange = moderate (3), red = major (4–5), grey = not inspected.
            Anything with a "Level" property (area tiles, defects) gets its colours from these two styles.
        -->
        <Style x:Key="LevelFillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Fine"><Setter Property="Background" Value="{DynamicResource MintSoftBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Minor"><Setter Property="Background" Value="{DynamicResource LemonSoftBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Moderate"><Setter Property="Background" Value="{DynamicResource PeachSoftBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Major"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LevelDotStyle" TargetType="Border">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SubtleTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Fine"><Setter Property="Background" Value="{DynamicResource MintBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Minor"><Setter Property="Background" Value="{DynamicResource LemonBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Moderate"><Setter Property="Background" Value="{DynamicResource PeachBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Major"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ===== Header ===== -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Back to card" Command="{Binding BackCommand}" Margin="0,0,8,0" />
                <Button Content="Inspect again" Command="{Binding InspectCommand}" Margin="0,0,8,0"
                        ToolTip="Open the inspection tools to add or correct findings (saved inspections are never changed)" />
                <Button Content="Save to history" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}"
                        ToolTip="Keep this result in the card's history, so you can compare it with the real grade later" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Grading report" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,2" />
                <TextBlock Text="{Binding CardTitle}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,10" />
            </StackPanel>
        </DockPanel>

        <!-- Never let this look like an official grade -->
        <Border DockPanel.Dock="Top" CornerRadius="10" Padding="12,8" Margin="0,0,0,12" Background="{DynamicResource LemonSoftBrush}">
            <TextBlock TextWrapping="Wrap">
                <Run Text="Preliminary, not an official grade." FontWeight="SemiBold" />
                <Run Text="{Binding Disclaimer, Mode=OneWay}" />
            </TextBlock>
        </Border>

        <!-- Nothing inspected yet -->
        <Border DockPanel.Dock="Top" Style="{StaticResource GlassPanelStyle}" VerticalAlignment="Top"
                Visibility="{Binding HasInspection, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="No inspection yet" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="The report is built from an inspection: centering lines and defects you mark on the photos. Inspect the card first." />
                <Button Content="Inspect this card" Command="{Binding InspectCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <!-- ===== Report ===== -->
        <Grid Visibility="{Binding HasInspection, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- Left: photo with highlighted defects -->
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Label Content="Inspection" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Inspections}" SelectedItem="{Binding Inspection}" Width="220" Margin="0,0,16,0"
                              AutomationProperties.Name="Inspection" ToolTip="Newest first" />
                    <Label Content="Grader" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" Width="240"
                              AutomationProperties.Name="Grader" ToolTip="Whose published limits to check your findings against" />
                </WrapPanel>

                <!-- Photo strip -->
                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Photos}" SelectedItem="{Binding SelectedPhoto}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0"
                         Margin="0,0,0,8" AutomationProperties.Name="Photos">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="84" Margin="2">
                                <Border Height="70" CornerRadius="8" Background="{DynamicResource InputBrush}" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail, IsAsync=True}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Caption}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Colour legend -->
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                            <Setter Property="Margin" Value="4,0,14,0" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </WrapPanel.Resources>
                    <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource MintBrush}" /><TextBlock Text="Fine (0–1)" />
                    <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource LemonBrush}" /><TextBlock Text="Minor (2)" />
                    <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource PeachBrush}" /><TextBlock Text="Moderate (3)" />
                    <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource DangerBrush}" /><TextBlock Text="Major (4–5)" />
                    <TextBlock Text="Severity is this app's own 0–5 scale, not a grader's." />
                </WrapPanel>

                <!-- Close-up of the selected defect -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource GlassTileStyle}" Padding="10" Margin="0,8,0,0"
                        Visibility="{Binding HasSelectedDefect, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <!-- An ImageBrush whose Viewbox is just the defect's area: WPF crops and enlarges it for us. -->
                        <Border DockPanel.Dock="Left" Width="160" Height="160" CornerRadius="8" Margin="0,0,12,0"
                                Background="{DynamicResource InputBrush}" ClipToBounds="True">
                            <Rectangle>
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding SelectedPhoto.Full}" Viewbox="{Binding SelectedDefect.CloseUp}"
                                                ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" FontSize="15">
                                <Run Text="{Binding SelectedDefect.Number, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding SelectedDefect.Title, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedDefect.SeverityText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SelectedDefect.Where}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SelectedDefect.Notes}" TextWrapping="Wrap" Margin="0,4,0,0" FontStyle="Italic"
                                       Visibility="{Binding SelectedDefect.Notes, Converter={StaticResource NotEmptyToVisibility}}" />
                            <TextBlock Style="{StaticResource SubtleTextStyle}" FontSize="11" Margin="0,6,0,0"
                                       Text="Click elsewhere on the photo or press Esc to see all defects again." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- The photo, scaled to fit, with the highlight layer on top at exactly the photo's size -->
                <Border Style="{StaticResource GlassPanelStyle}" Padding="12" ClipToBounds="True">
                    <Grid>
                        <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding SelectedPhoto, Converter={StaticResource EmptyToVisibility}}"
                                   Text="This card has no photos, so defects can't be shown on it." />
                        <Viewbox Stretch="Uniform">
                            <Grid Width="{Binding SelectedPhoto.Info.Width}" Height="{Binding SelectedPhoto.Info.Height}">
                                <Image Source="{Binding SelectedPhoto.Full}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
                                       AutomationProperties.Name="Photo" />
                                <controls:DefectHighlightOverlay Markers="{Binding VisibleDefects}" Selected="{Binding SelectedDefect}" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Right: the verdict, the four areas, defects, and why -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" />

                    <!-- Headline: the upper limit, always labelled as such -->
                    <Border Style="{StaticResource GlassPanelStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="BEST GRADE STILL POSSIBLE" Style="{StaticResource SubtleTextStyle}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LimitText}" Style="{StaticResource TileValueStyle}" Margin="0,2,0,4" />
                            <Border Style="{StaticResource ChipStyle}" Margin="0,0,0,8">
                                <TextBlock Text="Upper limit · preliminary · not an official grade" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" />
                            </Border>
                            <TextBlock Text="{Binding LimitExplanation}" TextWrapping="Wrap" />
                            <Border CornerRadius="10" Padding="10,6" Margin="0,10,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource PeachSoftBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource MintSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding EvidenceText}" TextWrapping="Wrap" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- The four areas at a glance -->
                    <Border Style="{StaticResource GlassPanelStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="The four areas" Style="{StaticResource SectionTitleStyle}" />
                            <ItemsControl ItemsSource="{Binding Areas}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LevelFillStyle}" Margin="3">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource LevelDotStyle}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Headline}" FontSize="15" Margin="0,4,0,2" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding CenteringLines}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Every defect, worst first; selecting one spotlights it on the photo -->
                    <Border Style="{StaticResource GlassPanelStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Defects" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding DefectSummary}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ListBox ItemsSource="{Binding Defects}" SelectedItem="{Binding SelectedDefect}" Background="Transparent"
                                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="False" AutomationProperties.Name="Defects">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter />
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LevelFillStyle}" Padding="10,8" Margin="0,2">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0" VerticalAlignment="Top">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource LevelDotStyle}">
                                                            <Setter Property="Width" Value="24" />
                                                            <Setter Property="Height" Value="24" />
                                                            <Setter Property="CornerRadius" Value="12" />
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="Black"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SeverityText}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Where}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Why the limit is what it is -->
                    <Border Style="{StaticResource GlassPanelStyle}" Margin="0,0,0,12"
                            Visibility="{Binding HasCeilings, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Why this limit" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Each finding below rules out the grades above it. The lowest one sets the limit." />
                            <ItemsControl ItemsSource="{Binding Ceilings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Grade}" Width="64" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDeciding}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12" />
                                                <TextBlock Text="Close to the limit: a small measuring error could change it." FontSize="11"
                                                           Foreground="{DynamicResource PeachBrush}" TextWrapping="Wrap"
                                                           Visibility="{Binding NearLimit, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- What's uncertain and what to do next -->
                    <Border Style="{StaticResource GlassPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="What's uncertain" Style="{StaticResource SectionTitleStyle}"
                                       Visibility="{Binding HasUncertainties, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Uncertainties}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" FontSize="12" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Next steps" Style="{StaticResource SectionTitleStyle}" />
                            <ItemsControl ItemsSource="{Binding NextSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" FontSize="12" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
