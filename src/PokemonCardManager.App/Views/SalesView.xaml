<UserControl x:Class="PokemonCardManager.App.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="_New sale or trade" Command="{Binding NewCommand}"
                    Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Top" />
            <TextBlock Text="Sales &amp; trades" Style="{StaticResource PageTitleStyle}" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Transactions}" SelectedItem="{Binding Selected}" Margin="0,0,16,0"
                     AutomationProperties.Name="Sales and trades" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource MutedTextStyle}">
                                <Run Text="{Binding CardCount, Mode=OneWay}" /> card(s) · <Run Text="{Binding Net, Mode=OneWay}" /> after costs
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Column="1" Style="{StaticResource MutedTextStyle}" Margin="0,40,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                       Text="Pick a sale or trade, or record a new one when cards leave your collection."
                       Visibility="{Binding HasForm, Converter={StaticResource InverseBoolToVisibility}}" />

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding HasForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <!-- What changed hands -->
                    <Border Style="{StaticResource GlassPanelStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitleStyle}" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,10,8"><Label Content="_Kind" Target="{Binding ElementName=TypeBox}" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="TypeBox" Width="90" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" DisplayMemberPath="Label"
                                              IsEnabled="{Binding IsNew}" /></StackPanel>
                                <StackPanel Margin="0,0,10,8"><Label Content="_Date" Target="{Binding ElementName=DateBox}" Style="{StaticResource FieldLabelStyle}" />
                                    <DatePicker x:Name="DateBox" Width="140" SelectedDate="{Binding Date}" /></StackPanel>
                                <StackPanel Margin="0,0,10,8"><Label Content="C_urrency" Target="{Binding ElementName=CurBox}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="CurBox" Width="60" Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Margin="0,0,10,8"><Label Content="_Amount received" Target="{Binding ElementName=AmountBox}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="AmountBox" Width="110" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Before fees. For a trade: the value you agreed, or 0." /></StackPanel>
                                <StackPanel Margin="0,0,10,8"><Label Content="_Fees" Target="{Binding ElementName=FeesBox}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="FeesBox" Width="90" Text="{Binding Fees, UpdateSourceTrigger=PropertyChanged}" ToolTip="Platform and payment fees you paid" /></StackPanel>
                                <StackPanel Margin="0,0,10,8"><Label Content="_Shipping" Target="{Binding ElementName=ShipBox}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="ShipBox" Width="90" Text="{Binding Shipping, UpdateSourceTrigger=PropertyChanged}" ToolTip="Shipping you paid" /></StackPanel>
                                <StackPanel Margin="0,0,10,8"><Label Content="_Buyer / trade partner" Target="{Binding ElementName=WhoBox}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="WhoBox" Width="160" Text="{Binding Counterparty, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Margin="0,0,10,8"><Label Content="_Where" Target="{Binding ElementName=WhereBox}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="WhereBox" Width="140" Text="{Binding Platform, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. Cardmarket, eBay, a card show" /></StackPanel>
                            </WrapPanel>
                            <Label Content="N_otes" Target="{Binding ElementName=SaleNotesBox}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="SaleNotesBox" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Margin="0,0,0,8"
                                     ToolTip="For a trade, what you got in return. Add the cards you received to the collection as usual." />
                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding ResultText, Converter={StaticResource NotEmptyToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- Cards -->
                    <Border Style="{StaticResource GlassPanelStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Cards" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Leave every share empty to split the amount evenly, or give each card its part. Profit compares the amount after fees with what the cards cost; purchase prices in another currency aren't converted." />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="No cards yet. Tick some below and add them."
                                       Visibility="{Binding HasLines, Converter={StaticResource InverseBoolToVisibility}}" />
                            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" AutomationProperties.Name="Cards in this sale"
                                      Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Card" Binding="{Binding Card}" IsReadOnly="True" Width="2*" />
                                    <DataGridTextColumn Header="Cost" Binding="{Binding Cost}" IsReadOnly="True" Width="*" />
                                    <DataGridTemplateColumn Header="Share" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBox Text="{Binding Share, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Share of the amount" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Remove" Command="{Binding RemoveCommand}" Padding="6,2"
                                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisibility}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="_Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}"
                                        ToolTip="Saving a new sale marks its cards Sold (or Traded)." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Pick cards (new sales only) -->
                    <Border Style="{StaticResource GlassPanelStyle}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Add cards" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Cards already sold or traded, or in a grading submission, aren't listed. Remove a card from a draft submission first." />
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Search" Command="{Binding FindCardsCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding CardSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search cards to sell">
                                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding FindCardsCommand}" /></TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Candidates}" MaxHeight="280" AutomationProperties.Name="Cards you can sell">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Card.Card}" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="_Add ticked cards" Command="{Binding AddCardsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
