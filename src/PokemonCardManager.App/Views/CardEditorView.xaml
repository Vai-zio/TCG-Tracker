<UserControl x:Class="PokemonCardManager.App.Views.CardEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Each field: a small label above its input -->
        <Style x:Key="FieldStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="DisplayMemberPath" Value="Label" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" />
                <Button Content="_Inspect" Command="{Binding InspectCommand}" Margin="0,0,8,0" ToolTip="Check photos, mark defects and measure centering" />
                <Button Content="Back (Esc)" Command="{Binding BackCommand}" Margin="0,0,8,0" />
                <Button Content="_Save (Ctrl+S)" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorTextStyle}"
                       Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisibility}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedTextStyle}"
                       Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <!-- The printing -->
                <Border Style="{StaticResource GlassPanelStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Card (the printing)" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="Set, number, language, finish and edition identify the printing. Details you change here apply to every copy of it." />
                        <WrapPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="_Set *" Target="{Binding ElementName=SetBox}" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="SetBox" Width="240" IsEditable="True" DisplayMemberPath="" ItemsSource="{Binding SetNames}"
                                          Text="{Binding SetName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="Card _name *" Target="{Binding ElementName=NameBox}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="NameBox" Width="240" Text="{Binding CardName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="N_umber *" Target="{Binding ElementName=NumberBox}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="NumberBox" Width="90" Text="{Binding CollectorNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="_Language" Target="{Binding ElementName=LanguageBox}" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="LanguageBox" Width="80" IsEditable="True" DisplayMemberPath="" ItemsSource="{Binding CommonLanguages}"
                                          Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="_Finish" Target="{Binding ElementName=FinishBox}" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="FinishBox" Width="140" ItemsSource="{Binding Finishes}" SelectedItem="{Binding Finish}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="_Edition" Target="{Binding ElementName=EditionBox}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="EditionBox" Width="140" Text="{Binding Edition, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="e.g. 1st Edition, Shadowless. Leave empty for the standard printing." />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="Pokémon / trainer" Target="{Binding ElementName=SubjectBox}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="SubjectBox" Width="180" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="_Rarity" Target="{Binding ElementName=RarityBox}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="RarityBox" Width="140" Text="{Binding Rarity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="Category" Target="{Binding ElementName=CategoryBox}" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="CategoryBox" Width="120" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="Release year" Target="{Binding ElementName=YearBox}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="YearBox" Width="80" Text="{Binding ReleaseYearText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <CheckBox Content="_Promo" IsChecked="{Binding IsPromo}" Margin="0,18,12,12" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- This copy -->
                <Border Style="{StaticResource GlassPanelStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Your copy" Style="{StaticResource SectionTitleStyle}" />
                        <WrapPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="Condition" Target="{Binding ElementName=ConditionBox}" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="ConditionBox" Width="160" ItemsSource="{Binding Conditions}" SelectedItem="{Binding RawCondition}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="Status" Target="{Binding ElementName=StatusBox}" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="StatusBox" Width="180" ItemsSource="{Binding Statuses}" SelectedItem="{Binding WorkflowStatus}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="Storage _location" Target="{Binding ElementName=LocationBox}" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="LocationBox" Width="260" ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="Acquired on" Target="{Binding ElementName=AcquiredBox}" Style="{StaticResource FieldLabelStyle}" />
                                <DatePicker x:Name="AcquiredBox" Width="140" SelectedDate="{Binding AcquiredOn}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="Price _paid" Target="{Binding ElementName=PriceBox}" Style="{StaticResource FieldLabelStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="PriceBox" Width="100" Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Width="56" Margin="4,0,0,0" Text="{Binding PurchaseCurrency, UpdateSourceTrigger=PropertyChanged}"
                                             CharacterCasing="Upper" MaxLength="3" AutomationProperties.Name="Currency" ToolTip="Currency, e.g. DKK" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="Estimated _value" Target="{Binding ElementName=EstimateBox}" Style="{StaticResource FieldLabelStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="EstimateBox" Width="100" Text="{Binding EstimatedValueText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Your own guess of what this copy is worth raw. Used on the dashboard when Market has no price." />
                                    <TextBox Width="56" Margin="4,0,0,0" Text="{Binding EstimatedCurrency, UpdateSourceTrigger=PropertyChanged}"
                                             CharacterCasing="Upper" MaxLength="3" AutomationProperties.Name="Estimated value currency" ToolTip="Currency, e.g. DKK" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldStyle}">
                                <Label Content="Acquired from" Target="{Binding ElementName=SourceBox}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="SourceBox" Width="200" Text="{Binding AcquisitionSource, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                        <Label Content="N_otes (private)" Target="{Binding ElementName=NotesBox}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="NotesBox" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top" />
                    </StackPanel>
                </Border>

                <!-- Photos -->
                <Border Style="{StaticResource GlassPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Photos" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="Photos are copied unchanged into the app's image folder; your originals are never modified. Save the card before adding photos." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ComboBox ItemsSource="{Binding ImageKinds}" SelectedItem="{Binding NewImageKind}" Width="170" Margin="0,0,8,0"
                                      AutomationProperties.Name="Photo type" />
                            <ComboBox ItemsSource="{Binding Sides}" SelectedItem="{Binding NewImageSide}" Width="90" Margin="0,0,8,0"
                                      AutomationProperties.Name="Card side" />
                            <Button Content="Add photos…" Command="{Binding AddPhotosCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Photos}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenPhotoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,10,10" Padding="6" ToolTip="Open in the inspector: zoom, compare and mark defects">
                                        <StackPanel Width="160">
                                            <Image Source="{Binding Thumbnail, IsAsync=True}" Height="200" Stretch="Uniform" />
                                            <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
