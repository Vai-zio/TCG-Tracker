<Window x:Class="TCGTracker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCG Tracker" Width="900" Height="600">
    <!-- Every {Binding X} reads property X from the DataContext, which is MainViewModel. -->
    <DockPanel Margin="12">

        <!-- Add-card form -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Set" />
                <TextBox Width="180" Text="{Binding NewSetName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Card name" />
                <TextBox Width="180" Text="{Binding NewCardName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Number" />
                <TextBox Width="80" Text="{Binding NewNumber, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Qty" />
                <TextBox Width="50" Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <Button Content="Add card" Command="{Binding AddCardCommand}"
                    VerticalAlignment="Bottom" Padding="12,2" IsDefault="True" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Foreground="Firebrick" Text="{Binding ErrorMessage}" Margin="0,0,0,8" />

        <!-- Collection list. DataGrid virtualizes rows, so it stays fast with thousands of cards. -->
        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Set" Binding="{Binding Card.CardSet.Name}" Width="2*" />
                <DataGridTextColumn Header="Number" Binding="{Binding Card.Number}" Width="*" />
                <DataGridTextColumn Header="Name" Binding="{Binding Card.Name}" Width="3*" />
                <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="*" />
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
