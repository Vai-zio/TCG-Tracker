<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Lets the project compile on non-Windows machines (e.g. CI). It still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TCGTracker.Core\TCGTracker.Core.csproj" />
    <ProjectReference Include="..\TCGTracker.Data\TCGTracker.Data.csproj" />
  </ItemGroup>

</Project>
